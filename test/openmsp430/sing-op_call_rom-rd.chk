# Initialization
at 1000
r1 = 0252 SP  initialization
r5 = 0000 R5  initialization
# Addressing mode: @Rn
at 2000
r1 = 0252 CALL (@Rn mode): SP value
r5 = 5678 CALL (@Rn mode): R5 value
# Addressing mode: @Rn+
at 3000
r1 = 0252 CALL (@Rn+ mode): SP value
r5 = 9abc CALL (@Rn+ mode): R5 value
# Addressing mode: X(Rn)
at 4000
r1 = 0252 CALL (X(Rn) mode): SP value
r5 = ef01 CALL (X(Rn) mode): R5 value
# Addressing mode: EDE
at 5000
r1 = 0252 CALL (EDE mode): SP value
r5 = 2345 CALL (EDE mode): R5 value
# Addressing mode: &EDE
at 6000
r1 = 0252 CALL (&EDE mode): SP value
r5 = 6789 CALL (&EDE mode): R5 value
