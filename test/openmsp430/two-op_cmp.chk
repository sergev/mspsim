# CMP (WORD MODE)
at 1000
r5 = 8888 CMP without Carry
r6 = 9999 CMP with Carry
# CMP.B (BYTE MODE)
at 2000
r5 = 8888 CMP.B  without Carry
r6 = 9999 CMP.B  with Carry
# CMP (WORD MODE): Check Flags
at 3000
r2 = 0004 CMP FLAG: Flag   check error: V=0, N=1, Z=0, C=0
r5 = 0666 CMP FLAG: Result check error: V=0, N=1, Z=0, C=0
at 3001
r2 = 0001 CMP FLAG: Flag   check error: V=0, N=0, Z=0, C=1
r5 = 0555 CMP FLAG: Result check error: V=0, N=0, Z=0, C=1
at 3002
r2 = 0003 CMP FLAG: Flag   check error: V=0, N=0, Z=1, C=1
r5 = 0333 CMP FLAG: Result check error: V=0, N=0, Z=1, C=1
at 3003
r2 = 0104 CMP FLAG: Flag   check error: V=1, N=1, Z=0, C=0
r5 = 7ff0 CMP FLAG: Result check error: V=1, N=1, Z=0, C=0
at 3004
r2 = 0101 CMP FLAG: Flag   check error: V=1, N=0, Z=0, C=1
r5 = 8000 CMP FLAG: Result check error: V=1, N=0, Z=0, C=1
