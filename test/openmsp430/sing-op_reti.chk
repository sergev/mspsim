# RETI Instruction test
at 1000
r4 = 0000 RESET Vector: R4  value
r5 = 0000 RESET Vector: R5  value
r6 = 0000 RESET Vector: R6  value
r7 = 0000 RESET Vector: R7  value
r8 = 0000 RESET Vector: R8  value
r9 = 0000 RESET Vector: R9  value
r10 = 0000 RESET Vector: R10 value
r11 = 0000 RESET Vector: R11 value
r12 = 0000 RESET Vector: R12 value
r13 = 0000 RESET Vector: R13 value
r14 = 0000 RESET Vector: R14 value
# RETI Instruction test
at 2000
r1 = 0252 RETI: SP value
r2 = 0145 RETI: SR value
r5 = 1234 RETI: R5 value
# Test interruption 0
at 3000
irq 0001 15
at 3001
r1 = 0252 IRQ  0: SP value
r2.3 = 0001 IRQ  0: GIE value
r6 = 5678 IRQ  0: R6 value
r7 = 0000 IRQ  0: R7 value
r8 = 024e IRQ  0: R8 value
