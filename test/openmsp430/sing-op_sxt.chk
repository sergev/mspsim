# Addressing mode: Rn
at 1000
r4 = 0024 SXT (Rn mode): test 1 (result)
r5 = 0001 SXT (Rn mode): test 1 (C flag)
r6 = ffb6 SXT (Rn mode): test 2 (result)
r7 = 0005 SXT (Rn mode): test 2 (C flag)
# Addressing mode: @Rn
at 2000
mem0200 = 0024 SXT (@Rn mode): test 1 (result)
r4 = 0200 SXT (@Rn mode): test 1 (address)
r5 = 0001 SXT (@Rn mode): test 1 (C flag)
mem0202 = ffb6 SXT (@Rn mode): test 2 (result)
r6 = 0202 SXT (@Rn mode): test 2 (address)
r7 = 0005 SXT (@Rn mode): test 2 (C flag)
