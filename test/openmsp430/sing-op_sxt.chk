r5 = 0001 SXT (@Rn+ mode): test 1 (C flag)
mem020a = ffb6 SXT (@Rn+ mode): test 2 (result)
r6 = 020c SXT (@Rn+ mode): test 2 (address)
r7 = 0005 SXT (@Rn+ mode): test 2 (C flag)
